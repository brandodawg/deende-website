filters:
  and:
    - file.inFolder("Spells")
formulas:
  Untitled: file.backlinks.filter(file(value).inFolder("Characters"))
properties:
  file.name:
    displayName: spell name
  formula.Untitled:
    displayName: spell casters
views:
  - type: table
    name: everyone
    groupBy:
      property: spell level
      direction: DESC
    order:
      - file.name
      - formula.Untitled
      - spell damage
    sort: []
    imageAspectRatio: 0.9
    cardSize: 140
  - type: table
    name: aoi
    filters:
      and:
        - formula.Untitled.contains(link("Aoi"))
    groupBy:
      property: spell level
      direction: DESC
    order:
      - file.name
      - spell damage
    sort: []
  - type: table
    name: beaver
    filters:
      and:
        - formula.Untitled.contains(link("Beaver"))
    groupBy:
      property: spell level
      direction: DESC
    order:
      - file.name
      - spell damage
  - type: table
    name: elise
    filters:
      and:
        - formula.Untitled.contains(link("Elise"))
    groupBy:
      property: spell level
      direction: DESC
    order:
      - file.name
      - spell damage
  - type: table
    name: jeremiah
    filters:
      and:
        - formula.Untitled.contains(link("Jeremiah"))
    groupBy:
      property: spell level
      direction: DESC
    order:
      - file.name
      - spell damage
  - type: table
    name: lil durk
    filters:
      and:
        - formula.Untitled.contains(link("Lil Durk"))
    order:
      - file.name
      - spell damage
    sort: []
  - type: table
    name: noah
    filters:
      and:
        - formula.Untitled.contains(link("Noah"))
    groupBy:
      property: spell level
      direction: DESC
